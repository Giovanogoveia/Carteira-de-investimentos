<body>
<div class="container">
<header><div><h1>Minha Carteira de FIIs</h1><div class="subtitle">Fundos imobiliários · Cotações e rendimentos</div></div><button class="primary" id="refreshBtn">↻ Atualizar dados</button></header>
<section class="cards">
<div class="card"><div class="card-label">Fundos monitorados</div><div class="card-value" id="totalFundos">16</div><div class="card-description">FIIs na carteira</div></div>
<div class="card"><div class="card-label">Cotações recebidas</div><div class="card-value" id="cotacoesRecebidas">0/16</div><div class="card-description">Dados recebidos da API</div></div>
<div class="card"><div class="card-label">Últimos rendimentos</div><div class="card-value" id="rendimentosRecebidos">0/16</div><div class="card-description">Fundos com rendimento identificado</div></div>
<div class="card"><div class="card-label">Última consulta</div><div class="card-value" id="horaAtualizacao" style="font-size:18px">Ainda não consultado</div><div class="card-description">Horário local do navegador</div></div>
</section>
<section class="panel"><div class="panel-header"><h2>Cotações e dividendos</h2><span class="badge">Fonte: carteira_ativos</span></div><div class="table-wrap"><table><thead><tr><th>FII</th><th>Cotas</th><th>Última cotação</th><th>P/VP</th><th>Dividendo/cota</th><th>Dividendo total estimado</th><th>DY do último dividendo</th></tr></thead><tbody id="tabelaFIIs"></tbody></table></div><div class="status" id="status">Conectando ao Supabase para carregar os dados salvos no banco.</div></section>
<section class="panel"><div class="panel-header"><h2>Conexão com o banco</h2><span class="badge">Somente leitura</span></div><div class="settings help"><p>Este painel consulta somente <strong>carteira_ativos</strong> para obter os FIIs, quantidade de cotas, última cotação, P/VP, último dividendo por cota e data de atualização. Não consulta <strong>historico_fii</strong> nem APIs externas.</p><p>O dividendo total estimado é calculado pela quantidade de cotas multiplicada pelo último dividendo por cota. A cotação e o dividendo são os valores salvos no banco.</p></div></section>
<section class="panel"><div class="panel-header"><h2>Como interpretar o DY</h2></div><div class="settings help"><p>DY do último rendimento = (último rendimento por cota ÷ última cotação) × 100.</p><p>O indicador é calculado com os campos <strong>ultimo_dy</strong> e <strong>ultima_cotacao</strong> retornados pelo Supabase. O P/VP é carregado do campo <strong>p_vp</strong> em <strong>carteira_ativos</strong> e exibido em múltiplos (por exemplo, 0,98x). O P/VP compara o preço da cota com o valor patrimonial por cota; não é um indicador de dividendos.</p><p>O painel exibe os dados que já existem no banco. Valores ausentes aparecem como indisponíveis; nenhuma cotação ou distribuição é inventada.</p></div></section>
<footer>Dashboard pessoal de investimentos · HTML, CSS e JavaScript<br>Confira a data de cada informação antes de tomar decisões.</footer>
</div>
<script>
'use strict';
const SUPABASE_URL='https://pajxqphtoaufldptaldh.supabase.co';
const SUPABASE_KEY='sb_publishable_kyymk01GtvAVJvWCQRJu0Q_WW8RBsKR';
const STORAGE_DATA='dashboard_fii_supabase_cache_v1';
let dadosFIIs={};
const $=id=>document.getElementById(id);
const FIIS_PADRAO=['RURA11','TRXF11','GARE11','GGRC11','HGLG11','XPML11','MXRF11','XPLG11','CPTS11','KNCR11','BRCR11','SNAG11','VISC11','XPCI11','RBRX11','PSEC11'];
function ordenarCodigos(codes){return [...codes].sort((a,b)=>{const x=dadosFIIs[a]||{},y=dadosFIIs[b]||{};const dx=Number(x.preco)>0&&Number(x.dividendo)>=0?Number(x.dividendo)/Number(x.preco):-1;const dy=Number(y.preco)>0&&Number(y.dividendo)>=0?Number(y.dividendo)/Number(y.preco):-1;if(dx<0&&dy>=0)return 1;if(dy<0&&dx>=0)return -1;return dy-dx||a.localeCompare(b);});}
function moeda(v){return v===null||v===undefined||v===''||!Number.isFinite(Number(v))?'—':Number(v).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});}
function numero(v){return v===null||v===undefined||v===''||!Number.isFinite(Number(v))?'—':Number(v).toLocaleString('pt-BR',{maximumFractionDigits:4});}
function percentual(v){return v===null||v===undefined||!Number.isFinite(Number(v))?'—':Number(v).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2})+'%';}
function dataBR(v){if(!v)return 'Não informada';const d=new Date(v);return Number.isNaN(d.getTime())?'Não informada':d.toLocaleString('pt-BR',{dateStyle:'short',timeStyle:'short',timeZone:'America/Sao_Paulo'});}
function status(msg,tipo=''){ $('status').textContent=msg;$('status').className='status '+tipo; }
function criarTabela(codigos=FIIS_PADRAO){$('tabelaFIIs').innerHTML=codigos.map(t=>`<tr><td class="ticker">${t}</td><td class="money" id="qtd-${t}">—</td><td class="money" id="preco-${t}">—</td><td class="money" id="pvp-${t}">—</td><td class="money" id="dividendo-${t}">—</td><td class="money" id="totaldiv-${t}">—</td><td class="money" id="dy-${t}">—</td></tr>`).join('');}
function atualizarLinha(t){const x=dadosFIIs[t]||{};const el=id=>$(id+'-'+t);if(!el('preco'))return;el('qtd').textContent=numero(x.quantidade);el('preco').textContent=moeda(x.preco);el('pvp').textContent=x.pvp===null||x.pvp===undefined||!Number.isFinite(Number(x.pvp))?'—':Number(x.pvp).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2})+'x';el('dividendo').textContent=moeda(x.dividendo);el('totaldiv').textContent=x.quantidade!==null&&x.quantidade!==undefined&&x.dividendo!==null&&x.dividendo!==undefined?moeda(Number(x.quantidade)*Number(x.dividendo)):'—';const e=el('dy');if(Number(x.preco)>0&&x.dividendo!==null&&x.dividendo!==undefined&&Number.isFinite(Number(x.dividendo))&&Number(x.dividendo)>=0){e.textContent=percentual(Number(x.dividendo)/Number(x.preco)*100);e.className='positive';}else{e.textContent='—';e.className='';}}
function atualizarResumo(){const keys=Object.keys(dadosFIIs);$('totalFundos').textContent=keys.length;$('cotacoesRecebidas').textContent=keys.filter(t=>Number(dadosFIIs[t]?.preco)>0).length+'/'+keys.length;$('rendimentosRecebidos').textContent=keys.filter(t=>dadosFIIs[t]?.dividendo!==null&&dadosFIIs[t]?.dividendo!==undefined&&Number.isFinite(Number(dadosFIIs[t]?.dividendo))).length+'/'+keys.length;}
function normalizar(row){return {quantidade:row.quantidade===null?null:Number(row.quantidade),preco:row.ultima_cotacao===null?null:Number(row.ultima_cotacao),pvp:row.p_vp===null||row.p_vp===undefined?null:Number(row.p_vp),dividendo:row.ultimo_dy===null?null:Number(row.ultimo_dy),atualizado:dataBR(row.data_atualizacao)};}
function salvarCache(){try{localStorage.setItem(STORAGE_DATA,JSON.stringify({dados:dadosFIIs,salvoEm:new Date().toISOString()}));}catch(e){}}
function carregarCache(){try{const c=JSON.parse(localStorage.getItem(STORAGE_DATA)||'null');if(c?.dados&&Object.keys(c.dados).length){dadosFIIs=c.dados;const codes=ordenarCodigos(Object.keys(dadosFIIs));criarTabela(codes);codes.forEach(atualizarLinha);atualizarResumo();if(c.salvoEm)$('horaAtualizacao').textContent=new Date(c.salvoEm).toLocaleTimeString('pt-BR');status('Exibindo os últimos dados salvos neste navegador enquanto consulta o banco…');}}catch(e){}}
async function atualizarDados(){const b=$('refreshBtn');b.disabled=true;b.textContent='Conectando…';status('Buscando FIIs, cotações e últimos dividendos em carteira_ativos…');const controller=new AbortController();const timeout=setTimeout(()=>controller.abort(),12000);try{const url=SUPABASE_URL+'/rest/v1/carteira_ativos?select=codigo,tipo,quantidade,ultima_cotacao,p_vp,ultimo_dy,data_atualizacao&order=codigo.asc';const r=await fetch(url,{method:'GET',headers:{apikey:SUPABASE_KEY,Authorization:'Bearer '+SUPABASE_KEY,Accept:'application/json'},signal:controller.signal,cache:'no-store'});let body;try{body=await r.json();}catch{throw new Error('O banco retornou uma resposta inválida.');}if(!r.ok)throw new Error(body?.message||body?.hint||('Erro HTTP '+r.status));if(!Array.isArray(body))throw new Error('Formato de dados inesperado recebido do Supabase.');const novo={};for(const row of body){const codigo=String(row.codigo||'').trim().toUpperCase();const tipo=String(row.tipo||'').toLowerCase();if(!codigo)continue;if(!(tipo.includes('fii')||FIIS_PADRAO.includes(codigo)))continue;novo[codigo]=normalizar(row);}if(!Object.keys(novo).length)throw new Error('Nenhum FII encontrado em carteira_ativos. Verifique as permissões de leitura (RLS) da tabela.');dadosFIIs=novo;const codes=ordenarCodigos(Object.keys(dadosFIIs));criarTabela(codes);codes.forEach(atualizarLinha);atualizarResumo();const now=new Date();$('horaAtualizacao').textContent=now.toLocaleTimeString('pt-BR');salvarCache();status('Conectado: '+codes.length+' FIIs carregados de carteira_ativos. Cotação, quantidade e último dividendo por cota vêm do banco; o dividendo total e o DY são calculados no painel.','success');}catch(e){const msg=e.name==='AbortError'?'A consulta ao Supabase excedeu 12 segundos. Verifique a conexão ou as permissões de leitura (RLS).':e.message;status(msg,'error');if(!Object.keys(dadosFIIs).length)status(msg+' Nenhum dado em cache disponível.','error');}finally{clearTimeout(timeout);b.disabled=false;b.textContent='↻ Atualizar dados';}}
$('refreshBtn').addEventListener('click',atualizarDados);
criarTabela();carregarCache();atualizarDados();
</script>
</body>
</html>
